5 rows in set (0.00 sec)



3.Update employee salary:-

mysql> UPDATE employee
    -> set salary=100000
    -> where empId=102;
Query OK, 1 row affected (0.01 sec)
Rows matched: 1  Changed: 1  Warnings: 0

mysql> SELECT *FROM employee;

Output:-

+-------+----------+--------+
| empId | name     | salary |
+-------+----------+--------+
|   101 | Vikash   | 970000 |
|   102 | Vishal   | 100000 |
|   103 | Anuj     |  90000 |
|   104 | Anupam   |  88000 |
|   105 | Virendra |  70000 |
+-------+----------+--------+
5 rows in set (0.00 sec)





4.Delete employee:-


mysql> DELETE FROM employee WHERE empId=103;
Query OK, 1 row affected (0.01 sec)

mysql> SELECT *FROM employee;

Output:- 

+-------+----------+--------+
| empId | name     | salary |
+-------+----------+--------+
|   101 | Vikash   | 970000 |
|   102 | Vishal   | 100000 |
|   104 | Anupam   |  88000 |
|   105 | Virendra |  70000 |
+-------+----------+--------+
4 rows in set (0.00 sec)




5. Search Employee By Name:-

mysql> SELECT *FROM employee
    -> WHere name="Vikash";
    
Output:-    
    
+-------+--------+--------+
| empId | name   | salary |
+-------+--------+--------+
|   101 | Vikash | 970000 |
+-------+--------+--------+
1 row in set (0.00 sec)

mysql> SELECT *FROM employee
    -> WHERE name LIKE 'V%';
    
Output:-
+-------+----------+--------+
| empId | name     | salary |
+-------+----------+--------+
|   101 | Vikash   | 970000 |
|   102 | Vishal   | 100000 |
|   105 | Virendra |  70000 |
+-------+----------+--------+
3 rows in set (0.02 sec)

